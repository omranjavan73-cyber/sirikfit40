rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "omran.javan73@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // CMS collection
    match /cms/{docId} {
      allow read, write: if true;
    }

    // Settings collection (app, cms, financial, general, pricing_rules, security, backupSchedule, adminSecurity)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Support Tickets collection
    match /tickets/{ticketId} {
      allow read, write: if true;
    }

    // Visitor Stats & Analytics collections
    match /analytics/{docId} {
      allow read, write: if true;
    }

    match /analytics_daily/{docId} {
      allow read, write: if true;
    }

    match /visitor_stats/{docId} {
      allow read, write: if true;
    }

    // Audit logs collections
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Backups collection
    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Scraped Products Cache collection
    match /scraped_products_cache/{urlHash} {
      allow read, write: if true;
    }

    // FAQs collection
    match /faqs/{faqId} {
      allow read, write: if true;
    }

    // User Inquiries collection
    match /user_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Financial Expenses collection
    match /financial_expenses/{expenseId} {
      allow read, write: if true;
    }

    // Discount Codes collection
    match /discount_codes/{codeId} {
      allow read, write: if true;
    }

    // Default deny catch-all for unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
