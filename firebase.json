{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/saveFinancialSettings",
        "function": "saveFinancialSettings"
      },
      {
        "source": "/syncPricingRules",
        "function": "syncPricingRules"
      },
      {
        "source": "/saveCmsSettings",
        "function": "saveCmsSettings"
      },
      {
        "source": "/saveSettings",
        "function": "saveSettings"
      },
      {
        "source": "/getVisitorStats",
        "function": "getVisitorStats"
      },
      {
        "source": "/getAdminOrders",
        "function": "getAdminOrders"
      },
      {
        "source": "/parseLink",
        "function": "parseLink"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}